# SIMPLI push-sender configuration
# Generate the VAPID pair once with:  npm run gen-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com

# SpacetimeDB target (defaults match the app; override only if you renamed the DB)
STDB_URI=wss://maincloud.spacetimedb.com
STDB_DB=server-simpli
# Optional: a token to pin an identity. Empty = anonymous read (fine for public tables).
STDB_TOKEN=
